flowchart LR
	student[Estudiante]
	professor[Profesor]
	admin[Administrador]

	subgraph university[Universidad]
		subgraph moodleSite[Sitio Moodle]
			moodle[Plataforma Moodle y libro de calificaciones]
			courseImport[Importación de actividades al curso]
			subgraph course[Curso de Moodle]
				activities[Actividad calificada de herramienta externa LTI]
			end
			moodle --> course
			courseImport -->|importa la actividad al| course
		end
	end

	subgraph management[Gestión de actividades]
		manager[Aplicación Django Manager]
		activityExport[Paquete de actividades exportado]
		manager -->|exporta actividades| activityExport
	end

	subgraph integration[Capa de integración - propuesta]
		gateway[Pasarela LTI<br/>Proveedor de herramienta / intermediario de lanzamiento]
	end

	subgraph deployment[Despliegue de Open WebUI]
		subgraph docker[Docker]
			studentWebui[Open WebUI personalizado<br/>Diálogo de chat para estudiantes]
			adminWebui[Open WebUI original<br/>Interfaz para administradores]
			modelAccess[Conexiones a modelos de Open WebUI]
		end
		postgres[(PostgreSQL)]
		studentWebui -->|datos de la aplicación| postgres
		adminWebui -->|datos de la aplicación| postgres
		studentWebui --> modelAccess
		adminWebui --> modelAccess
	end

	subgraph modelBackends[Modelos de lenguaje]
		companyModels[Modelos grandes alojados por empresas<br/>Gemini, Kimi y otros]
		inHouseLarge[Modelos grandes gestionados internamente<br/>opcional]
		inHouseSmall[Modelos pequeños ejecutados internamente<br/>opcional]
	end

	modelAccess -->|API del proveedor| companyModels
	modelAccess -->|punto de acceso privado| inHouseLarge
	modelAccess -->|punto de acceso de inferencia local| inHouseSmall

	student -->|abre la actividad| activities
	professor -->|crea y gestiona actividades| manager
	professor -->|importa el paquete al curso| courseImport
	admin -->|acceso al Manager con privilegios de administración| manager
	admin -->|acceso directo| adminWebui
	admin -->|acceso a la base de datos para análisis| postgres
	activityExport -->|se proporciona para su importación| courseImport
	activities -->|Lanzamiento LTI 1.1<br/>Solicitud firmada con OAuth 1.0| gateway
	activities -->|Lanzamiento LTI 1.3<br/>OIDC y JWT firmado| gateway
	gateway -->|valida el lanzamiento; asocia usuario, curso y actividad| student
	student -->|redirección o sesión mediante proxy| studentWebui
	gateway -.->|devolución opcional de calificaciones LTI 1.1<br/>Servicio Basic Outcomes| moodle
	gateway -.->|devolución opcional de calificaciones LTI 1.3<br/>Assignment and Grade Services - AGS| moodle
