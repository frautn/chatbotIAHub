POSTGRES_USER=webui_user
POSTGRES_PASSWORD='use-a-strong-password'
POSTGRES_DB=webui_db
START_POSTGRES=true

OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY='your-provider-api-key'
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
WEBUI_SECRET_KEY='generate-with-openssl-rand-hex-32'
DATABASE_URL='postgresql://webui_user:use-a-strong-password@host.docker.internal:5432/webui_db'

START_MOODLE=false
MOODLE_SRC_DIR=/absolute/path/to/moodle-5.3
MOODLE_DB_HOST=host.docker.internal
MOODLE_DB_PORT=5432
MOODLE_DB_NAME=moodle_db
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASS='use-a-strong-password'
MOODLE_WWWROOT=https://moodle.example.com
MOODLE_WEB_PORT=8081
MOODLE_SSLPROXY=true
MOODLE_UPLOAD_MAX_FILESIZE=200M
MOODLE_POST_MAX_SIZE=210M
MOODLE_PHP_MEMORY_LIMIT=256M

START_LTI=false
LTI_PUBLIC_URL=https://chat.example.com
LTI_GATEWAY_SECRET_KEY='generate-with-openssl-rand-hex-32'
LTI_GATEWAY_API_TOKEN='generate-with-openssl-rand-hex-32'
LTI_GATEWAY_PORT=8090
LTI_WEBUI_PORT=3001
LTI_SESSION_TTL=28800
LTI_USER_EMAIL_DOMAIN=lti.invalid

# Set START_POSTGRES=false to use an external PostgreSQL server.
# Update DATABASE_URL and MOODLE_DB_HOST/PORT/NAME/USER/PASS to match it.
