POSTGRES_USER=webui_user
POSTGRES_PASSWORD='use-a-strong-password'
POSTGRES_DB=webui_db
POSTGRES_PORT=5432
START_POSTGRES=true

CLOUDBEAVER_IMAGE=dbeaver/cloudbeaver:latest
CLOUDBEAVER_PORT=8978

OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY='your-provider-api-key'
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPENWEBUI_IMAGE_LTI=ghcr.io/frautn/open-webui-chat-simplified:v0.12.3-arm
WEBUI_PORT=3000
WEBUI_SECRET_KEY='generate-with-openssl-rand-hex-32'
DATABASE_URL='postgresql://webui_user:use-a-strong-password@host.docker.internal:5432/webui_db'
DEFAULT_LOCALE='es-ES'
DEFAULT_INTERFACE_SETTINGS='{"language": "es-ES"}'

START_LTI=false
LTI_PUBLIC_URL=https://chat.example.com
LTI_GATEWAY_SECRET_KEY='generate-with-openssl-rand-hex-32'
LTI_GATEWAY_API_TOKEN='generate-with-openssl-rand-hex-32'
LTI_GATEWAY_PORT=8090
LTI_WEBUI_PORT=3001
LTI_SESSION_TTL=28800
LTI_USER_EMAIL_DOMAIN=lti.invalid
# Open WebUI models teachers may pin a deep-linked activity to, as
# comma-separated `id` or `id:Label` entries; leave empty to hide the picker
# and always use Open WebUI's default model.
LTI_GATEWAY_MODELS='cinematica-ej-1:Cinemática - Ejercicio 1,cinematica-ej-2:Cinemática - Ejercicio 2'
# Lets the gateway resume a learner's previous chat on relaunch by reaching
# open-webui-lti directly inside the Docker network; clear it to disable.
LTI_GATEWAY_WEBUI_INTERNAL_URL=http://open-webui-lti:8080

# Optional LTI 1.3 shared-admin activity. Every valid Moodle launcher, including
# learners, receives FULL administrator access to the same existing account.
# Requires the dedicated admin hostname/nginx server from gateway/README.md.
# Both admin and student hosts use OPENWEBUI_IMAGE_LTI, not OPENWEBUI_IMAGE.
LTI_ADMIN_ENABLED=false
LTI_ADMIN_PUBLIC_URL=https://lti-admin.fcr.lat
LTI_ADMIN_EMAIL=''
LTI_ADMIN_WEBUI_INTERNAL_URL=http://open-webui-lti:8080

# LTI 1.1 gateway (legacy Basic Launch / Basic Outcomes), runs alongside the
# LTI 1.3 one above and reuses the same open-webui-lti instance/group.
LTI11_PUBLIC_URL=https://chat11.example.com
LTI11_GATEWAY_SECRET_KEY='generate-with-openssl-rand-hex-32'
LTI11_GATEWAY_API_TOKEN='generate-with-openssl-rand-hex-32'
LTI11_GATEWAY_PORT=8091
LTI11_SESSION_TTL=28800
LTI11_USER_EMAIL_DOMAIN=lti.invalid
LTI11_GATEWAY_MODELS=''
LTI11_GATEWAY_WEBUI_INTERNAL_URL=http://open-webui-lti:8080
# Consumer key/secret for Moodle's LTI 1.1 "External tool" config; must also be
# written to the gateway's consumers.json (see gateway/README.md).
LTI11_CONSUMER_KEY='moodle_site_key_for_LTI1.1'
LTI11_CONSUMER_SECRET='moodle_site_secret_for_LTI1.1'

# Set START_POSTGRES=false to use an external PostgreSQL server.
# Update DATABASE_URL and MOODLE_DB_HOST/PORT/NAME/USER/PASS to match it.

# POSTGRES_PORT and WEBUI_PORT are the host-published ports for Postgres and
# the stock Open WebUI container; change them if those ports are already
# taken on your machine (keep DATABASE_URL's port in sync with POSTGRES_PORT).
